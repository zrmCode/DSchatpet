# 统一行尾,避免 Windows / Linux 协作时整文件 diff
* text=auto

# 源码与文档用 LF
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.spec    text eol=lf
*.iss     text eol=lf

# Windows 专用脚本保留 CRLF(批处理用 LF 在某些情况下会出问题)
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制
*.png     binary
*.jpg     binary
*.ico     binary
*.exe     binary
*.dll     binary
*.moc3    binary
*.model3.json binary
